# Optional: Explicit GoPro camera IP.
# If unset, gopro2cloud will automatically probe standard subnets (e.g. 172.2X.XXX.51).
GOPRO_IP=

# Default rclone cloud destination (e.g., gdrive:GoPro, dropbox:GoPro, s3:my-bucket/gopro)
GOPRO2CLOUD_DEST=gdrive:GoPro

# Default upload mode: "stream" (zero disk usage via copyurl) or "staged" (local single-file cache)
GOPRO2CLOUD_MODE=stream
